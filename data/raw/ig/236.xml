            <div type="edition" xml:space="preserve">
                <ab xmlns="http://www.tei-c.org/ns/1.0"><div xmlns="http://www.tei-c.org/ns/1.0" type="textpart" subtype="fragment" n="I"><lb n="1"/>a-ri-si-to-ta-mo-ne | e-mi ←<lb n="2"/>to | pi-lo-ku-po-ro-ne.</div><div xmlns="http://www.tei-c.org/ns/1.0" type="textpart" subtype="fragment" n="II"><lb n="1"/>Ἀρι <hi rend="smallit">vacat</hi></div></ab>
            </div>
            <div type="translation" xml:lang="DE" resp="Klaus Hallof"><ab xmlns="http://www.tei-c.org/ns/1.0"><div xmlns="http://www.tei-c.org/ns/1.0" type="textpart" subtype="fragment" n="I"><lb n="1"/>Des Aristodamos (Grabstein) bin ich,<lb n="2"/>S.d. Philokypros.</div><div xmlns="http://www.tei-c.org/ns/1.0" type="textpart" subtype="fragment" n="II"><lb n="1"/>Ἀρι <hi rend="smallit">vacat</hi></div></ab></div><div type="translation" xml:lang="GRC" resp=" "><ab xmlns="http://www.tei-c.org/ns/1.0"><div xmlns="http://www.tei-c.org/ns/1.0" type="textpart" subtype="fragment" n="I"><lb n="1"/>Ἀριστοδάμων ἠμὶ<lb n="2"/>τῶ Φιλοκύπρων.</div></ab></div>
